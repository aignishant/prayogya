# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# Every variable here is documented on the day that introduced it. If you are looking at a name
# and cannot tell what it is for, that is a bug in that day's document — say so.

# Groq API key — the default development provider (day 25). Free tier: per-model daily caps.
GROQ_API_KEY=

# Gemini API key — the second provider, used through its OpenAI-compatible endpoint (day 25).
GEMINI_API_KEY=

# OpenRouter API key — reserved for the portability days; `:free` models are capped at 50/day.
OPENROUTER_API_KEY=
