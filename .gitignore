# Secrets never touch git. This file exists before the first secret does.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.*

# The learner's own scratch work inside a day. The teaching lives in parts/.
# `days/*/lab/` was the v3 pattern and never matched, because a day sits one level deeper:
# days/<project>/day-DD-<slug>/lab/. `**` is what reaches it.
days/**/lab/

# Generated locally, never committed
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
*.swp



# projects/00-foundry/.gitignore
# The rule comes first. This file exists before any file it names does.

# Secrets. Never committed — not once, not "just to test the pipeline".
.env
.env.*
!.env.example
*.key
*.pem
service-account.json

# Written by uv from uv.lock. Rebuildable, so never committed and never copied.
.venv/
__pycache__/
*.pyc


